<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <title>身份证号码校验</title>
    <style>
        *{box-sizing: border-box;font-family:system-ui;}
        body{max-width:500px;margin:60px auto;padding:0 20px;}
        .box{padding:24px;border:1px solid #ddd;border-radius:10px;}
        h2{text-align:center;margin-top:0;}
        #idInput{width:100%;padding:12px;font-size:18px;margin:12px 0;border:1px solid #ccc;border-radius:6px;}
        #checkBtn{width:100%;padding:12px;font-size:18px;background:#2563eb;color:white;border:none;border-radius:6px;cursor:pointer;}
        #result{margin-top:16px;font-size:17px;padding:10px;border-radius:6px;}
        .ok{background:#dcfce7;color:#166534;}
        .err{background:#fee2e2;color:#991b1b;}
    </style>
</head>
<body>
<div class="box">
    <h2>身份证号码校验器</h2>
    <input type="text" id="idInput" placeholder="请输入18位身份证号码">
    <button id="checkBtn">开始校验</button>
    <div id="result"></div>
</div>

<script>
const weight = [7,9,10,5,8,4,2,1,6,3,7,9,10,5,8,4,2];
const codeTable = ['1','0','X','9','8','7','6','5','4','3','2'];

function checkIdCard(){
    const id = document.getElementById('idInput').value.trim().toUpperCase();
    const resDom = document.getElementById('result');

    if(id.length !== 18){
        resDom.className = 'err';
        resDom.innerText = '❌ 错误：必须是18位';
        return;
    }
    const front17 = id.slice(0,17);
    if(!/^\d{17}$/.test(front17)){
        resDom.className = 'err';
        resDom.innerText = '❌ 错误：前17位必须为数字';
        return;
    }
    const birthStr = id.slice(6,14);
    const y = birthStr.slice(0,4);
    const m = birthStr.slice(4,6);
    const d = birthStr.slice(6,8);
    const birthDate = new Date(`${y}-${m}-${d}`);
    if(birthDate.getFullYear()!==Number(y) || birthDate.getMonth()+1!==Number(m) || birthDate.getDate()!==Number(d)){
        resDom.className = 'err';
        resDom.innerText = '❌ 错误：出生日期不合法';
        return;
    }
    let sum = 0;
    for(let i=0;i<17;i++){
        sum += Number(id[i]) * weight[i];
    }
    const remainder = sum % 11;
    const checkCode = codeTable[remainder];
    if(checkCode === id[17]){
        resDom.className = 'ok';
        resDom.innerText = '✅ 校验通过！';
    }else{
        resDom.className = 'err';
        resDom.innerText = '❌ 校验码不匹配';
    }
}

document.getElementById('checkBtn').addEventListener('click', checkIdCard);
document.getElementById('idInput').addEventListener('keydown',function(e){
    if(e.key === 'Enter') checkIdCard();
})
</script>
</body>
</html>
